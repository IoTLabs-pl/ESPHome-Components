{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "github-actions": {
    "enabled": true
  },
  "customManagers": [
    {
      "managerFilePatterns": [".github/workflows/build.yaml"],
      "fileFormat": "yaml",
      "customType": "jsonata",
      "matchStrings": [
        "{\"currentValue\": env.ESPHOME_VERSION}"
      ],
      "packageNameTemplate": "esphome/esphome",
      "datasourceTemplate": "github-releases"
    }
  ]
}
